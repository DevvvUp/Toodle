{
  "expo": {
    "name": "Toodle",
    "slug": "floodguard-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brand/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.floodguard.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The app accesses your camera to capture live images for flood detection."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Toodle to use your location to geotag reports."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo.png",
          "backgroundColor": "#090909",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "floodguard-ai",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85c60d9b-bc94-4692-895f-426384d8176c"
      }
    },
    "owner": "rudyyyyy"
  }
}
